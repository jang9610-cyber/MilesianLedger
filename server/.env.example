# Server secret only. Leave empty until you configure the hosting secret store.
NEXON_API_KEY=
HOST=127.0.0.1
PORT=8787
# Conservative shared application budget, not a statement of Nexon's issued quota.
UPSTREAM_REQUESTS_PER_24H=500
UPSTREAM_REQUESTS_PER_SECOND=5
CLIENT_REQUESTS_PER_MINUTE=600
CACHE_TTL_SECONDS=60
# Relative to server/, or an absolute persistent-volume path. Do not commit this directory.
RUNTIME_DIRECTORY=.runtime
